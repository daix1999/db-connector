      "env": {
        "DB_SOURCES": "[{\"name\":\"mysql\",\"dialect\":\"mysql\",\"host\":\"127.0.0.1\",\"port\":3306,\"user\":\"root\",\"password\":\"<MySQL密码>\",\"database\":\"test\"},{\"name\":\"redis\",\"dialect\":\"redis\",\"host\":\"127.0.0.1\",\"port\":6379,\"database\":\"0\"},{\"name\":\"mongo\",\"dialect\":\"mongodb\",\"host\":\"127.0.0.1\",\"port\":27017,\"database\":\"admin\"}]",
