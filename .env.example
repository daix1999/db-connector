# db-connector MCP server 环境变量样例
# 复制为 .env（已在 .gitignore 中），填真实值。凭据只注入进程环境，勿提交。

# ===== 推荐：多源（JSON 字符串）=====
# 每个源是一个"连接环境"，带自己的 host/port/账号/库 + access 权限。
# access 可写：档名字符串 / 内联 dict / {"profile":"档名",...覆盖}
DB_SOURCES=[{"name":"mysql8-prod","dialect":"mysql","host":"127.0.0.1","port":3306,"user":"app","password":"CHANGE_ME","database":"biz","access":"prod"},{"name":"redis","dialect":"redis","host":"127.0.0.1","port":6379,"database":"0","access":"readonly"},{"name":"mongo","dialect":"mongodb","host":"127.0.0.1","port":27017,"database":"app","access":"readonly"}]

# 权限档：优先从文件加载（仓库内自带示例），也可用 DB_ACCESS_PROFILES 内联覆盖同名档
DB_ACCESS_PROFILE_FILE=access_profiles.json
#DB_ACCESS_PROFILES={"prod":{"grant":"read+destructive","confirm_from":"read+data"},"readonly":{"grant":"read"}}

# ===== 全局兜底 =====
DB_ALLOW_WRITE=false        # 无 access 时：false=只读，true=给到破坏性且免确认
DB_MAX_ROWS=200             # 单次返回行数上限（SQL 自动补 LIMIT）

# ===== 审计 =====
DB_AUDIT=on                 # off 关闭
DB_AUDIT_LAYER=all          # all|connector|mcp|off
DB_AUDIT_LOG=logs/db-connector-audit.jsonl
DB_AUDIT_PARAMS=            # 1=记录参数值(敏感)，默认只记形状

# ===== 确认令牌 =====
#DB_CONFIRM_SECRET=固定随机串   # 不设则每进程随机、重启即作废
#DB_CONFIRM_TTL=300              # 秒

# ===== 单方言兼容（老写法，无 DB_SOURCES 时生效）=====
#DB_DIALECT=mysql
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_USER=root
#DB_PASSWORD=change_me
#DB_DATABASE=test
